.cover {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-md);
  background: var(--color-secondary);
}

.meta {
  margin-top: 12rpx;
}

.step {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.step__idx {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-secondary);
  color: var(--color-primary);
  font-size: 24rpx;
  flex-shrink: 0;
}
