.about-row { margin-bottom: 16rpx; }
.label { color: var(--color-text-muted); margin-right: 16rpx; }
.pay-hint { margin-bottom: 20rpx; padding: 0 4rpx; }
.pay-qr-grid { display: flex; flex-direction: column; gap: 20rpx; }
.pay-qr__title { font-weight: 600; margin-bottom: 16rpx; }
.pay-qr__img {
  width: 100%;
  height: 420rpx;
  background: var(--color-secondary);
  border-radius: 12rpx;
}
