.hint { margin-bottom: 24rpx; }
.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.preset {
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
}
.preview { margin: 32rpx 0; }
.preview__bar { margin-bottom: 20rpx; font-weight: 600; }
.preview__chip {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
