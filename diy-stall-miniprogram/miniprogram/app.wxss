@import './styles/tokens.wxss';

page {
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.page--tab {
  padding-bottom: 32rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.card__body {
  padding: 28rpx 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin: 32rpx 0 20rpx;
}

.section-title--first {
  margin-top: 8rpx;
}

.text-muted {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--color-secondary);
  color: var(--color-primary);
}

.hero {
  background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: var(--radius-md);
  padding: 40rpx 36rpx;
  color: #fff;
}

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 10rpx;
  vertical-align: middle;
}

.status-dot--open {
  background: #95D5B2;
}

.status-dot--closed {
  background: #E9C46A;
}

.product-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.product-row__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--color-secondary);
  flex-shrink: 0;
}

.product-row__name {
  font-size: 30rpx;
  font-weight: 600;
}

.product-row__price {
  color: var(--color-accent);
  font-weight: 600;
  margin-top: 8rpx;
}

.admin-entry {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.admin-entry text {
  color: var(--color-primary);
  text-decoration: underline;
}
